# App Configuration
APP_NAME=CocheraVecina
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-very-long-random-secret-key-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
# For local development without Docker, sqlite+aiosqlite:///./cochera_vecina.db can be used.
# For production / Docker / Coolify, use postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cochera_vecina

# Media / Upload Storage
STORAGE_BACKEND=local
MEDIA_ROOT=./media
# If using S3 / MinIO on Coolify:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=cochera-media

# Stripe Connect Configuration
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Commission Settings (in basis points or percentages)
# 10% guest fee = 1000 basis points or 0.10
GUEST_SERVICE_FEE_PERCENTAGE=0.10
# 5% host fee = 500 basis points or 0.05
HOST_SERVICE_FEE_PERCENTAGE=0.05

# Frontend URL (for CORS and Stripe redirect URLs)
FRONTEND_URL=http://localhost:3000
